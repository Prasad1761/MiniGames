datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Player {
  id           String        @id @default(uuid())
  anonymousId  String        @unique
  username     String        @default("ArcadePlayer")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  scores       Score[]
  challenges   Challenge[]   @relation("CreatorChallenges")
  runSessions  RunSession[]
  achievements Achievement[]

  @@index([anonymousId])
}

model RunSession {
  id          String   @id @default(uuid())
  gameId      String
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  seed        Int      @default(42)
  startedAt   DateTime @default(now())
  expiresAt   DateTime
  completed   Boolean  @default(false)
  scores      Score[]

  @@index([playerId, gameId])
}

model Score {
  id           String      @id @default(uuid())
  gameId       String
  score        Int
  durationMs   Int?
  meta         String?     // JSON with extra info e.g. ms, combo, accuracy
  playerId     String
  player       Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  runSessionId String?
  runSession   RunSession? @relation(fields: [runSessionId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  isDaily      Boolean     @default(false)
  dailyDate    String?     // YYYY-MM-DD

  @@index([gameId, score(sort: Desc)])
  @@index([gameId, dailyDate, score(sort: Desc)])
  @@index([playerId, gameId])
}

model Challenge {
  id          String    @id @default(uuid())
  gameId      String
  targetScore Int
  creatorId   String
  creator     Player    @relation("CreatorChallenges", fields: [creatorId], references: [id], onDelete: Cascade)
  seed        Int       @default(42)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime

  @@index([creatorId])
  @@index([expiresAt])
}

model Achievement {
  id            String   @id @default(uuid())
  playerId      String
  achievementId String
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([playerId, achievementId])
}

model Tournament {
  id        String   @id @default(uuid())
  name      String
  gameId    String
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime @default(now())

  @@index([gameId, startAt])
}
